# KAGE Environment Configuration
# Copy this file to .env (never commit real keys to git!)

# === GROQ API KEY (Recommended) ===
# Used for the Sensei AI coach + intelligent LLM-powered program recommendations.
# 1. Go to https://console.groq.com/keys
# 2. Create a free key (starts with gsk_)
# 3. Paste it below
#
# IMPORTANT: The key you put here or in the app Settings is stored in your browser.
# Never share your real key in chats or screenshots.
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_real_key_here

# Optional: default bodyweight (kg) for nutrition math
# BODYWEIGHT=75
